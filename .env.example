# Lytrobot RAG Pipeline - Environment Configuration

# MongoDB Atlas Connection (Primary Data Source)
# Using Azure Cosmos DB API for MongoDB or MongoDB Atlas
# Format: mongodb+srv://<user>:<password>@<cluster>.<connection-string>.mongodb.net/?retryWrites=true&w=majority
# Local Development: mongodb://127.0.0.1:27017/pokelytro
MONGODB_URI=

# MongoDB Database Name
MONGODB_DATABASE=pokelytro

# Groq API Key (Required for LLM Inference)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=

# Groq Model Selection
# Recommended: llama-3.1-70b-versatile (high-quality reasoning)
# Alternative: llama-3.1-8b-instant (faster, lower cost)
GROQ_MODEL=llama-3.1-70b-versatile

# Groq Inference Parameters
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.7

# Embedding Model Configuration
# Using sentence-transformers/all-MiniLM-L6-v2 (384-dim, lightweight)
# This MUST match the dimension of vectors in MongoDB Atlas Vector Search index
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Vector Search Parameters
# Initial retrieval pool before reranking
VECTOR_SEARCH_INITIAL_CANDIDATES=20
# Final top-k results after reranking
VECTOR_SEARCH_RERANKED_TOPK=5

# Query Expansion Setting
# Number of semantic variations generated from user query
EXPANSION_QUERY_COUNT=3

# API Configuration
API_V1_PREFIX=/api
PROJECT_NAME=Lytrobot
DEBUG=False

# CORS Origins (Allowed Frontend Domains)
# Comma-separated list of domains that can call this API
CORS_ORIGINS=http://localhost:3000,http://localhost:4200,https://pokelytro.vercel.app
